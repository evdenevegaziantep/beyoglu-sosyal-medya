# Never commit real secrets. Configure these in the hosting provider's secret manager.
WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
META_APP_SECRET=set-from-meta-app-dashboard
ADMIN_KEY=generate-a-different-long-random-value
PII_HASH_SALT=generate-another-random-value
CAPI_ACCESS_TOKEN=set-a-system-user-or-dataset-token
META_DATASET_ID=set-after-events-manager-creates-the-business-messaging-dataset
GRAPH_VERSION=v26.0
DB_PATH=/var/data/whatsapp-conversions.sqlite3
ALLOW_UNSIGNED_WEBHOOKS=false
